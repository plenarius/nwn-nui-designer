{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error"
  },
  "env": { "browser": true, "node": true, "es2024": true },
  "ignorePatterns": ["dist/**", "dist-electron/**", "release/**", "local/**", ".golden-out/**", "src/core/layout/kiwi/**"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "react/set-state-in-effect": "off",
    "react/immutability": "off",
    "react/refs": "off",
    "react/purity": "off",
    "react/globals": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/label-has-associated-control": "off",
    "jsx-a11y/control-has-associated-label": "off",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-shadow": "error",
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "caughtErrors": "none" }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-empty-object-type": "error",
    "no-useless-constructor": "error",
    "unicorn/prefer-node-protocol": "error",
    "import/default": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "vitest/valid-title": "off",
    "vitest/no-conditional-expect": "off",
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expectRect", "sameBelow"] }]
  },
  "overrides": [
    {
      "files": ["tests/**/*.browser.ts"],
      "rules": { "react-hooks/rules-of-hooks": "off" }
    }
  ]
}
