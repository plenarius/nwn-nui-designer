# nwn-nui-designer open skin, preset s-oxblood (S3: Oxblood and rivets). Written for this project, not Beamdog's file;
# generated by src/core/skin/gen (pnpm skin ship). Every key the NWN:EE 8193.37 client reads is set.
# This file and the textures: CC0 1.0 (see LICENSE). Fonts: Zilla Slab SemiBold, JetBrains Mono and Cinzel Decorative Bold ("display"), SIL OFL 1.1.

background_color = "#000000FF"
color = "#F0F0F0FF"
border_color = "#C49A52FF"
selected_color = "#C49A52FF"

[[fonts]]
  name = "(default)"
  resref = "nuio_zillasb"
  pixel_height = 0.0
  pixel_snap = true
  oversample_h = 1.0
  oversample_v = 1.0
  font_size = 18.0
  spacing_h = 0.5
  spacing_v = 0.0

[[fonts]]
  name = "(monospace)"
  resref = "nuio_jbmono"
  pixel_height = 0.0
  pixel_snap = true
  oversample_h = 1.0
  oversample_v = 1.0
  font_size = 17.0
  spacing_h = 0.5
  spacing_v = 0.0

[[fonts]]
  name = "display"
  resref = "nuio_cinzldb"
  pixel_height = 0.0
  pixel_snap = true
  oversample_h = 1.0
  oversample_v = 1.0
  font_size = 22.0
  spacing_h = 0.5
  spacing_v = 0.0

[text]
color = "#F0E2C4FF"

[border]
border_image = "nui_windowh"

[window]
fixed_background = "#2A0C0EFF"
background = "#2A0C0EFF"
border_image = "nui_windowh"
border_color = "#00000000"
popup_border_color = "#00000000"
combo_border_color = "#00000000"
contextual_border_color = "#00000000"
menu_border_color = "#00000000"
group_border_color = "#00000000"
tooltip_border_color = "#00000000"
scaler = "#C49A52FF"
padding_x = 0
padding_y = 0
scrollbar_size_x = 18
scrollbar_size_y = 18

[window.header]
normal = "nuio_title"
hover = "nuio_title"
active = "nuio_title"
label_normal = "#E2C384FF"
label_hover = "#E2C384FF"
label_active = "#FFE6A8FF"

[window.header.close_button]
normal = "nui_close"
hover = "nui_close"
active = "nui_close"
padding_x = 5
padding_y = 5

[window.header.minimize_button]
normal = "nui_cnt_down"
hover = "nui_cnt_down"
active = "nui_cnt_down"
padding_x = 5
padding_y = 5

[chart]
border = 1

[scrollv]
normal = "nui_windowv"
hover = "nui_windowv"
active = "nui_windowv"
cursor_normal = "nui_scrollv"
cursor_hover = "nui_scrollv"
cursor_active = "nui_scrollv"
border_color = "#C49A52FF"
padding_x = 4
padding_y = 2

[scrollv.dec_button]
normal = "nui_cnt_up"
hover = "nui_cnt_up"
active = "nui_cnt_up"

[scrollv.inc_button]
normal = "nui_cnt_down"
hover = "nui_cnt_down"
active = "nui_cnt_down"

[scrollh]
normal = "nuio_trackh"
hover = "nuio_trackh"
active = "nuio_trackh"
cursor_normal = "nui_scrollh"
cursor_hover = "nui_scrollh"
cursor_active = "nui_scrollh"
padding_x = 4
padding_y = 2

[scrollh.dec_button]
normal = "nui_cnt_left"
hover = "nui_cnt_left"
active = "nui_cnt_left"

[scrollh.inc_button]
normal = "nui_cnt_right"
hover = "nui_cnt_right"
active = "nui_cnt_right"

[checkbox]
normal = "nui_checkbox_n"
hover = "nui_checkbox_h"
active = "nui_checkbox_h"
cursor_normal = "nui_checkbox_x"
cursor_hover = "nui_checkbox_x"

[option]
normal = "nui_radial_n"
hover = "nui_radial_h"
active = "nui_radial_h"
cursor_normal = "nui_radial_x"
cursor_hover = "nui_radial_x"

[button]
normal = "nui_button_n"
hover = "nui_button_h"
active = "nui_button_a"
text_background = "#F8F8F8FF"
text_normal = "#F0E2C4FF"
text_hover = "#FFFFFFFF"
text_active = "#FFFFFFFF"
border = 0

[contextual_button]
normal = "#2A0C0EFF"
active = "#C49A52FF"
hover = "#4A1A1CFF"
padding_x = 4
padding_y = 2

[tab]
background = "nui_header"

[tab.tab_minimize_button]
normal = "nui_minimize"
active = "nui_minimize"
hover = "nui_minimize"

[tab.tab_maximize_button]
normal = "nui_maximize"
active = "nui_maximize"
hover = "nui_maximize"

[tab.node_minimize_button]
normal = "nui_minimize"
active = "nui_minimize"
hover = "nui_minimize"

[tab.node_maximize_button]
normal = "nui_maximize"
active = "nui_maximize"
hover = "nui_maximize"

[slider]
cursor_normal = "nui_slider"
cursor_hover = "nui_slider"
cursor_active = "nui_slider"
bar_filled = "#C49A52FF"

[selectable]
normal = "nui_button_n"
pressed = "nui_button_a"
normal_active = "nui_button_a"
pressed_active = "nui_button_ah"
hover_active = "nui_button_ah"
hover = "nui_button_h"
padding_x = 10
padding_y = 0

[progress]
normal = "nui_button_n"
hover = "nui_button_h"
active = "nui_button_h"
cursor_normal = "nui_progress"
cursor_hover = "nui_progress"
cursor_active = "nui_progress"

[property]
normal = "#2A0C0EFF"
active = "#2A0C0EFF"
hover = "#2A0C0EFF"

[property.dec_button]
normal = "nui_shld_left"
hover = "nui_shld_left"
active = "nui_shld_left"

[property.inc_button]
normal = "nui_shld_right"
hover = "nui_shld_right"
active = "nui_shld_right"

[property.edit]
normal = "#2A0C0EFF"
hover = "#2A0C0EFF"
active = "#2A0C0EFF"

[combo]
normal = "nui_button_n"
hover = "nui_button_h"
active = "nui_button_a"
content_padding_x = 10
content_padding_y = 0

[combo.button]
normal = "nui_shld_down"
active = "nui_shld_down"
hover = "nui_shld_down"

[edit]
normal = "nui_windowh"
hover = "nui_windowh"
active = "nui_windowh"
border_color = "#C49A52FF"
text_normal = "#F0E2C4FF"
padding_x = 10
padding_y = 0

